# 家族统一端口键（X18 槽：lab=5214）。缺值 startup fail-fast，禁默认兜底。
SERVER_PORT=5214
# family PG：dev/test=127.0.0.1:54321/lab_dev（families/lab.md）
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54321/lab_dev
# CORS allowlist（逗号分隔；家族 §6 对称纪律——须含跨源前端 dev origin）
LAB_CORS_ALLOWED_ORIGINS=http://localhost:5201
# saas IdP 代理（auth login 消费；saas 家族 IdP 本体 5101）
SAAS_IDP_URL=http://localhost:5101
LAB_SAAS_SERVICE_USER=alice
LAB_SAAS_SERVICE_PASSWORD=dev123456
LAB_SAAS_SERVICE_CLIENT_ID=lab-management
LAB_SAAS_CLIENT_ID=lab-management
# JWT 签发（HS256；secret ≥32 字节 fail-fast；prod 值=家族统一 secret，CI secrets 转发）
LAB_JWT_SECRET=dev-only-secret-replace-in-prod-0123456789
LAB_JWT_ISSUER=lab-management-system
LAB_JWT_TTL_SECONDS=3600
